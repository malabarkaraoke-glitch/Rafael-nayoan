		local flat=Vector3.new(dX,0,dZ)
		dx lokal = datar.Magnitudo
		jika dx<0.5 atau speed<=0 maka kembalikan nil
		v2 lokal = kecepatan * kecepatan
		disk lokal = v2 * v2 - g * (g * dx * dx + 2 * dY * v2)
