			akhir))
			table.insert(godConns,hum.HealthChanged:Connect(function()
				jika godOn dan hum.Parent dan hum.Health<hum.MaxHealth maka
					hum.Kesehatan=hum.KesehatanMaksimal
				akhir
			akhir))
		akhir
		applyNoTouch()
	akhir

	-- UI
