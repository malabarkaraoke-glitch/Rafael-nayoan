fungsi lokal makeDraggable(handle,target,onTap)
	penyeretan lokal, dipindahkan, dragStart, startPos, faktor=false, false, nil, nil, 1
	handle.InputBegan:Connect(function(i))
		jika i.UserInputType==Enum.UserInputType.MouseButton1
		atau i.UserInputType==Enum.UserInputType.Touch maka
			menyeret=benar; dipindahkan=salah
			dragStart=i.Posisi; startPos=target.Posisi
			lokal sc=target:TemukanAnakPertamaDariKelas("UIScale")
			faktor=sc dan sc.Skala atau 1
			i.Changed:Connect(function()
				jika i.UserInputState==Enum.UserInputState.End maka
					menyeret=false
					jika tidak dipindahkan dan onTap maka onTap() berakhir
				akhir
			akhir)
		akhir
	akhir)
	lacak(UIS.InputChanged:Hubungkan(fungsi(i))
		jika menyeret dan (i.UserInputType==Enum.UserInputType.MouseMovement
		atau i.UserInputType==Enum.UserInputType.Touch) maka
			lokal d=i.Posisi-dragStart
			jika d.Magnitude>6 maka moved=true end
			d=d/faktor
			target.Posisi=UDim2.baru(
				startPos.X.Scale,startPos.X.Offset+dX,
				startPos.Y.Scale,startPos.Y.Offset+dY)
		akhir
	akhir))
akhir
