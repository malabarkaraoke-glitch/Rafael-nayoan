		untuk _,r dalam ipairs(hpSources) lakukan
			lokal cur=readSrc(r)
			jika tipe(cur)=="number" dan cur~=r.max dan (force atau cur<r.max) maka
				jika r.kind=="value" maka
					pcall(function() r.obj.Value=r.max end)
				kalau tidak
					pcall(function() r.inst:SetAttribute(r.name,r.max) end)
				akhir
			akhir
		akhir
	akhir

