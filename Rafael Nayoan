				table.insert(hpSources,{kind="value",obj=d,max=d.Value})
			akhir
		akhir
		untuk nama, nilai dalam pasangan (orang tua:GetAttributes()) lakukan
			jika tipe(val)=="angka" dan isHpName(nama) maka
				hpSeenAttr[parent]=hpSeenAttr[parent] atau {}
				jika tidak hpSeenAttr[parent][name] maka
					hpSeenAttr[parent][name]=true
					table.insert(hpSources,{kind="attr",inst=parent,name=name,max=val})
				akhir
			akhir
		akhir
