	fungsi lokal scanHp()
		karakter lokal=lp.Karakter
		jika char maka scanParent(char,true) end
		lokal hum=char dan char:FindFirstChildOfClass("Humanoid")
		jika hum maka scanParent(hum,false) end
		untuk _,c dalam ipairs(lp:GetChildren()) lakukan
			jika c.Name~="PlayerGui" maka scanParent(c,true) end
		akhir
		scanParent(lp,false)
		lokal rs=game:GetService("ReplicatedStorage")
		lokal pf=rs:FindFirstChild(lp.Name) atau rs:FindFirstChild(tostring(lp.UserId))
		jika pf maka scanParent(pf,true) end
		lokal ls=lp:TemukanAnakPertama("statistikpemimpin")
		jika ls maka scanParent(ls,false) end
		untuk i=#hpSources,1,-1 lakukan
			lokal r=hpSources[i]
			induk lokal=(r.kind=="value") dan r.obj.Parent atau r.inst.Parent
			jika bukan orang tua maka
				tabel.hapus(hpSources,i)
			kalau tidak
